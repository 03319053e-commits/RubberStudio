# -*- mode: python ; coding: utf-8 -*-
"""PyInstaller spec for RUBBER STUDIO (one-folder, windowed).

    python -m PyInstaller packaging/RubberStudio.spec --noconfirm --clean

Output: dist/RubberStudio/RubberStudio.exe (+ _internal/). Zip the folder to distribute it.
The spec also builds on Linux/macOS (icon and version resource are Windows-only and are ignored there),
which is how the layout of the bundled data is checked without a Windows machine.
"""
import re
import sys
from pathlib import Path

ROOT = Path(SPECPATH).resolve().parent          # SPECPATH is provided by PyInstaller
sys.path.insert(0, str(ROOT))

from rubberstudio import APP_ID, APP_NAME, __version__  # noqa: E402

# ------------------------------------------------------------------ version resource (Windows)


def write_version_info(version: str) -> str:
    nums = [int(p) if p.isdigit() else 0 for p in (version.split(".") + ["0"] * 4)[:4]]
    tup = "(%d, %d, %d, %d)" % tuple(nums)
    text = f"""# UTF-8 - generated by RubberStudio.spec, do not edit
VSVersionInfo(
  ffi=FixedFileInfo(
    filevers={tup},
    prodvers={tup},
    mask=0x3f,
    flags=0x0,
    OS=0x40004,
    fileType=0x1,
    subtype=0x0,
    date=(0, 0)
    ),
  kids=[
    StringFileInfo(
      [
      StringTable(
        u'040904B0',
        [StringStruct(u'CompanyName', u'{APP_NAME} (open source)'),
        StringStruct(u'FileDescription', u'{APP_NAME} - batch text remover and photo repair'),
        StringStruct(u'FileVersion', u'{version}'),
        StringStruct(u'InternalName', u'{APP_ID}'),
        StringStruct(u'LegalCopyright', u'MIT License'),
        StringStruct(u'OriginalFilename', u'{APP_ID}.exe'),
        StringStruct(u'ProductName', u'{APP_NAME}'),
        StringStruct(u'ProductVersion', u'{version}')])
      ]),
    VarFileInfo([VarStruct(u'Translation', [1033, 1200])])
  ]
)
"""
    out = ROOT / "packaging" / "version_info.txt"
    out.write_text(text, encoding="utf-8")
    return str(out)


# ------------------------------------------------------------------ data files


def tree(src: Path, dest: str, skip=()):
    """(file, destination folder) pairs for every file below ``src``."""
    pairs = []
    for f in sorted(src.rglob("*")):
        if f.is_file() and f.name not in skip and "__pycache__" not in f.parts:
            pairs.append((str(f), str(Path(dest) / f.relative_to(src).parent)))
    return pairs


datas = (
    tree(ROOT / "assets", "assets", skip=("icon-source.jpg",))
    + tree(ROOT / "rubberstudio" / "core" / "models", "rubberstudio/core/models")
    + [(str(ROOT / "LICENSE"), "."), (str(ROOT / "NOTICE.md"), ".")]
)

# Things the app never touches but that are installed next to it in a developer environment.
excludes = [
    "tkinter", "matplotlib", "scipy", "pandas", "IPython", "jupyter", "pytest", "onnx",
    "PySide6.QtQml", "PySide6.QtQuick", "PySide6.QtQuickWidgets", "PySide6.QtPdf", "PySide6.QtPdfWidgets",
    "PySide6.QtWebEngineCore", "PySide6.QtMultimedia", "PySide6.Qt3DCore", "PySide6.QtSql", "PySide6.QtTest",
    "PySide6.QtDesigner", "PySide6.QtHelp",
]

a = Analysis(
    [str(ROOT / "packaging" / "launcher.py")],
    pathex=[str(ROOT)],
    binaries=[],
    datas=datas,
    hiddenimports=[],
    hookspath=[],
    runtime_hooks=[],
    excludes=excludes,
    noarchive=False,
)

# Slim the bundle: software OpenGL, PDF/QML/Quick runtimes, Qt's own translations and OpenCV's video back-end are
# never used by this app (Qt Widgets paints with the raster engine; OpenCV is used for still images only).
_DROP_BIN = re.compile(
    r"^(lib)?(opengl32sw|qt6pdf|qt6qml|qt6quick|qt6virtualkeyboard|qt6svgwidgets|opencv_videoio_ffmpeg)", re.I)
_DROP_PLUGIN = re.compile(r"(^|[\\/])(imageformats[\\/](lib)?qpdf|qmltooling|qmllint)", re.I)
a.binaries = [b for b in a.binaries if not _DROP_BIN.match(Path(b[0]).name) and not _DROP_PLUGIN.search(b[0])]
a.datas = [d for d in a.datas if not re.search(r"[\\/]translations[\\/]", d[0].replace("\\", "/"))]

pyz = PYZ(a.pure)

_icon = ROOT / "assets" / "icon.ico"
exe = EXE(
    pyz,
    a.scripts,
    [],
    exclude_binaries=True,
    name=APP_ID,
    debug=False,
    bootloader_ignore_signals=False,
    strip=False,
    upx=False,                       # UPX-packed executables trigger far more antivirus false positives
    console=False,                   # windowed app; --selftest writes its report to a file instead
    disable_windowed_traceback=False,
    icon=str(_icon) if _icon.is_file() else None,
    version=write_version_info(__version__) if sys.platform.startswith("win") else None,
)

coll = COLLECT(
    exe,
    a.binaries,
    a.datas,
    strip=False,
    upx=False,
    name=APP_ID,
)
